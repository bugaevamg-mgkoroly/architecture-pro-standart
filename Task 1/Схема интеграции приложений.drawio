        <mxCell id="_tZcmoUtysCC9YyA1wNx-35" parent="1" style="html=1;whiteSpace=wrap;fontColor=default;labelBackgroundColor=default;" value="&lt;span style=&quot;font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; text-align: left; white-space: pre;&quot;&gt;Интернет‑банк.&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="170" x="260" y="365" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-1" parent="1" style="text;fontSize=8;spacing=0;whiteSpace=wrap;" value="Канал: HTTPS (веб‑интерфейс).&#xa;Периодичность: по запросу клиента.&#xa;Данные:&#xa;Заявка на депозит (ФИО, сумма, срок, реквизиты).&#xa;Согласие на обработку персональных данных.&#xa;Тип обмена: API (REST)." vertex="1">
          <mxGeometry height="77.5" width="120" x="80" y="400" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-2" parent="1" style="text;whiteSpace=wrap;fontSize=6;" value="Канал: API (HTTP/HTTPS).&#xa;Периодичность: в реальном времени.&#xa;Данные:&#xa;Заявка на депозит (с сайта/интернет‑банка).&#xa;Контактный телефон клиента.&#xa;Примечание: &#xa;для сайта — предварительная валидация &#xa;данных перед передачей." vertex="1">
          <mxGeometry height="141.25" width="130" x="470" y="400" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-5" parent="1" style="text;whiteSpace=wrap;fontSize=6;" value="Канал: API (SOAP/REST).&#xa;Периодичность:&#xa;В MVP (6 мес.): вручную (оператор отправляет заявку через интерфейс кол‑центра).&#xa;Финальное состояние (1 год): автоматически при получении заявки.&#xa;Данные:&#xa;Заполненная заявка на депозит.Идентификатор клиента (из CRM кол‑центра).&#xa;Формат: JSON/XML." vertex="1">
          <mxGeometry height="40" width="110" x="660" y="130" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-6" parent="1" style="text;whiteSpace=wrap;fontSize=6;" value="Канал: API (HTTPS).&#xa;Периодичность: сразу после &#xa;изменения статуса заявки.&#xa;Данные:&#xa;Текст уведомления &#xa;Номер телефона клиента.&#xa;Формат: JSON." vertex="1">
          <mxGeometry height="60" width="140" x="730" y="485" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-7" parent="1" style="fontColor=default;labelBackgroundColor=default;whiteSpace=wrap;" value="Система аутентификации &#xa;(IDM)" vertex="1">
          <mxGeometry height="60" width="170" x="260" y="120" as="geometry" />
        </mxCell>
        <mxCell id="9YQHyvpd48k43dP0-qDB-9" parent="1" style="text;whiteSpace=wrap;fontSize=6;" value="Канал: API (OAuth 2.0).&#xa;Периодичность: при входе клиента.&#xa;Данные:&#xa;Токены доступа.Проверка прав пользователя.&#xa;Формат: JWT." vertex="1">
          <mxGeometry height="50" width="140" x="260" y="230" as="geometry" />
        </mxCell>
